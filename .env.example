# Copy this file to .env and fill in real values locally. Never commit .env
# or write real credential values into this file or into README.md.

# Setup dashboard awal hanya membutuhkan AUTH_SECRET dan DASHBOARD_PASSWORD.
DASHBOARD_PASSWORD=
SUPER_ADMIN_PASSWORD=

# Buat dengan: openssl rand -hex 32
# Di production, server menolak start kalau AUTH_SECRET kosong atau kurang
# dari 32 karakter.
AUTH_SECRET=

# Publik -- dibundel ke browser crew, aman untuk exposure client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Jangan beri awalan VITE_, jangan masukkan ke kode browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, server-only (upload/manajemen katalog audio Super Admin).
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=soundboard
CF_R2_PUBLIC_URL=
# Base64 dari tepat 32 byte acak. Jangan dirotasi tanpa migrasi arsip QR lama.
QR_EXPORT_ENCRYPTION_KEY=

# Poin 2 — email undangan Super Admin + recovery (server-only). Tanpa kedua
# nilai ini, fitur invite/recovery Super Admin FAIL CLOSED (tidak ada akun
# separuh jadi yang dibuat).
RESEND_API_KEY=
STAFF_EMAIL_FROM=
# Origin absolut (HTTPS) untuk tautan sekali-pakai di email invite/accept/
# recovery. Kalau kosong, aplikasi memakai origin request berjalan; set eksplisit
# di production agar email selalu berisi tautan domain final.
STAFF_EMAIL_APP_URL=

# SUPER_ADMIN_PASSWORD hanya untuk fase bootstrap satu kali: membuat akun
# Super Admin individual PERTAMA. Setelah akun pertama itu terverifikasi dan
# aktif, gerbang bootstrap ditutup permanen di database dan env ini tidak
# lagi dipakai untuk login.
