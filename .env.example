# Salin ke .env lalu isi sendiri. JANGAN commit file .env.
# Semua nilai di bawah wajib diisi — aplikasi tidak punya kredensial fallback.

# Dibuat otomatis saat Vercel Blob Store dihubungkan ke project.
# Tanpa ini, seluruh tombol audio tampil non-aktif.
BLOB_READ_WRITE_TOKEN=

# String acak minimal 32 karakter. Contoh: openssl rand -hex 32
AUTH_SECRET=

# Kredensial halaman /manage (upload & ganti audio meja)
MANAGE_USERNAME=
MANAGE_PASSWORD=

# Password halaman dashboard soundboard
DASHBOARD_PASSWORD=
