# Salin ke .env lalu isi sendiri. JANGAN commit file .env.
# AUTH_SECRET dan DASHBOARD_PASSWORD wajib. Variabel Super Admin/Supabase opsional;
# tanpa Supabase, soundboard bundled tetap berfungsi tetapi remote audio offline.

# String acak minimal 32 karakter. Contoh: openssl rand -hex 32
AUTH_SECRET=

# Password halaman dashboard soundboard
DASHBOARD_PASSWORD=

# Catatan: audio sekarang ikut di-bundle bersama deployment
# (src/assets/audio/**), jadi TIDAK ada env storage apa pun yang dibutuhkan.

# Password khusus halaman /super-admin. Jangan gunakan password dashboard.
SUPER_ADMIN_PASSWORD=

# Supabase browser/public. Nilai VITE_ akan dikirim ke browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server-only. JANGAN beri awalan VITE_ atau memasukkan nilai ini ke browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
