# Salin ke .env lalu isi sendiri. JANGAN commit file .env.
# AUTH_SECRET dan DASHBOARD_PASSWORD wajib. Variabel Super Admin/Supabase/R2 opsional;
# tanpa layanan remote, login restoran dan sinkronisasi katalog tidak tersedia.

# String acak minimal 32 karakter. Contoh: openssl rand -hex 32
AUTH_SECRET=

# Password halaman dashboard soundboard
DASHBOARD_PASSWORD=

# Cloudflare R2 server-only untuk upload dan delivery audio same-origin.
# Bucket default adalah "soundboard" bila CF_R2_BUCKET dikosongkan.
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=soundboard
CF_R2_PUBLIC_URL=

# Password khusus halaman /super-admin. Jangan gunakan password dashboard.
SUPER_ADMIN_PASSWORD=

# Supabase browser/public. Nilai VITE_ akan dikirim ke browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server-only. JANGAN beri awalan VITE_ atau memasukkan nilai ini ke browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
